# Copia este archivo como .env y completa solo las claves que tengas.
# Todas son opcionales; .env no se sube al repositorio ni entra en la imagen.

# Tráfico en tiempo real (backend): rutas y hexágonos de tráfico lento.
TOMTOM_API_KEY=

# Ajustes del tráfico por hexágonos (opcionales). Se miden todos los hexágonos
# que cruzan las rutas; cada actualización usa unas 2 consultas por ruta más 1
# por hexágono, y la espera crece sola para que TOMTOM_HORAS_USO horas de uso
# quepan en la cuota diaria. TOMTOM_REFRESCO_S es la espera mínima.
TOMTOM_REFRESCO_S=600
TOMTOM_CUOTA_DIARIA=2500
TOMTOM_HORAS_USO=10
TRAFICO_HEX_RADIO_M=600
TRAFICO_HEX_MAX=150

# App móvil (http://IP-del-PC:8000/movil/). Por defecto solo responde en este
# equipo; 0.0.0.0 la abre a la red Wi-Fi. Cualquiera en esa red podrá usar la API.
#   py start.py     -> SIMULADOR_HOST=0.0.0.0
#   Docker          -> SIMULADOR_IP_PUBLICA=0.0.0.0
SIMULADOR_HOST=
SIMULADOR_IP_PUBLICA=

# Contraseña del dashboard en el navegador (puerto 6080). Ponla siempre que uses
# SIMULADOR_IP_PUBLICA=0.0.0.0: quien entre ahí puede crear y borrar rutas.
# VNC solo usa los primeros 8 caracteres.
VNC_PASSWORD=

# Mapa inicial: esri, osm, stadia o carto (también se cambia desde el dashboard).
MAPA_PROVEEDOR=

# Proveedores de mapas del dashboard. Esri y OpenStreetMap no necesitan clave.
STADIA_MAPS_API_KEY=
CARTO_API_KEY=
ARCGIS_API_KEY=
