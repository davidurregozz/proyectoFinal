# Copia este archivo como .env y completa solo las claves que tengas.
# Todas son opcionales; .env no se sube al repositorio ni entra en la imagen.

# Tráfico en tiempo real (backend): rutas y hexágonos de tráfico lento.
TOMTOM_API_KEY=

# Ajustes del tráfico por hexágonos (opcionales). Cada actualización usa unas
# 2 consultas por ruta más 1 por hexágono; la cuota gratuita es de 2.500 al día.
TOMTOM_REFRESCO_S=600
TRAFICO_HEX_RADIO_M=600
TRAFICO_HEX_MAX=30

# Mapa inicial: esri, osm, stadia o carto (también se cambia desde el dashboard).
MAPA_PROVEEDOR=

# Proveedores de mapas del dashboard. Esri y OpenStreetMap no necesitan clave.
STADIA_MAPS_API_KEY=
CARTO_API_KEY=
ARCGIS_API_KEY=
