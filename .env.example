# Copia este archivo como .env y completa solo las claves que tengas.
# Todas son opcionales; .env no se sube al repositorio ni entra en la imagen.

# Optimización de rutas con tráfico en tiempo real (backend).
TOMTOM_API_KEY=

# Mapa inicial: esri, osm, stadia o carto (también se cambia desde el dashboard).
MAPA_PROVEEDOR=

# Proveedores de mapas del dashboard. Esri y OpenStreetMap no necesitan clave.
STADIA_MAPS_API_KEY=
CARTO_API_KEY=
ARCGIS_API_KEY=
